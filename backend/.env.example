MODEL_API_KEY=
MODEL_NAME=
COURTLISTENER_TOKEN=
COURTLISTENER_TOKEN_FALLBACK=
CONTACT_EMAIL=
DATABASE_PATH=
FIRECRAWL_API_KEY=

# Ramp one-time virtual cards for pay_for_document (app/sources/ramp.py). Cards are made only when
# PAYMENTS_LIVE=true and all three RAMP_ keys are set; otherwise purchases stay a dry run.
# Client ID/secret: a Ramp Developer API app (client credentials) with scopes
# limits:write cards:read_vault funds:write. Production needs Ramp's PCI review for cards:read_vault.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# The Ramp user who owns the cards (their Ramp user id)
RAMP_USER_ID=
# sandbox (demo-api.ramp.com, no real money) or production
RAMP_ENV=sandbox
PAYMENTS_LIVE=false
